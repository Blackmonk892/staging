# staging_cloud configuration -- copy to `.env` (git-ignored) for a local run,
# or set these through your platform's environment / secret configuration in
# production. Every value below is a PLACEHOLDER.

# --- Required (no default; a missing one aborts startup) ---------------------

# MongoDB connection string. Use `memory://` for a persistence-free local run.
# For Atlas: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=memory://

# Shared secret for the `/` dashboard, every /admin/* route and the /video*
# viewer. Generate: `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
STAGING_ADMIN_TOKEN=change-me-to-a-long-random-string

# --- Optional (shown with their defaults) -----------------------------------

MONGODB_DB=nzerox_staging
HOST=0.0.0.0
PORT=8080
PAIRING_CODE_TTL_SECONDS=3600
CREDENTIAL_TTL_DAYS=30
HEARTBEAT_HISTORY_TTL_DAYS=7
UPDATE_CHANNEL=default
# Most recent MPEG-TS segments (~2s each) kept in memory per camera by the
# /v1/ingest/video test receiver. Bounds the footprint; nothing older is kept.
VIDEO_MAX_SEGMENTS_PER_CAMERA=20
ENV_NAME=staging
LOG_LEVEL=INFO
